{
    "name": "packages",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "NODE_OPTIONS=\"--experimental-strip-types\" prettier --write \"**/*.{ts,tsx,md,json}\"",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "turbo run build && changeset publish",
        "make:package": "jiti ./scripts/make-package/index.ts"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.5",
        "@types/eslint": "^9.6.1",
        "@types/node": "^24.0.1",
        "eslint": "^9.30.1",
        "jiti": "^2.4.2",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "turbo": "^2.5.4",
        "typescript": "^5.8.3"
    },
    "packageManager": "pnpm@9.4.0",
    "engines": {
        "node": ">=18"
    }
}
