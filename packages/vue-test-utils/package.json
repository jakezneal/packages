{
    "name": "@jakezneal/vue-test-utils",
    "version": "0.3.1",
    "license": "MIT",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./directives/*": {
            "types": "././dist/directives/*.d.ts",
            "import": "./dist/directives/*.mjs",
            "require": "./dist/directives/*.cjs"
        },
        "./wrapper-plugins/*": {
            "types": "././dist/wrapper-plugins/*.d.ts",
            "import": "./dist/wrapper-plugins/*.mjs",
            "require": "./dist/wrapper-plugins/*.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "./dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/directives src/wrapper-plugins --format esm,cjs --clean --dts",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "format": "prettier --write \"**/*.{ts,md,json}\"",
        "prepack": "pnpm build"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^24.0.13",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@types/lodash.merge": "^4.6.9",
        "@vue/test-utils": "^2.4.6",
        "lodash.merge": "^4.6.2",
        "vue": "^3.5.22"
    }
}
