{
    "name": "@jakezneal/hola",
    "version": "1.9.2",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "bin": {
        "hola": "./dist/index.mjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "unbuild",
        "stub": "unbuild --stub",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "format": "prettier --write \"**/*.{ts,md,json}\"",
        "prepack": "pnpm build",
        "play": "jiti ./src/index.ts",
        "generate:readme": "jiti ./src/commands/generate-readme/index.ts",
        "version": "pnpm generate:readme"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "c12": "^3.0.4",
        "citty": "^0.1.6",
        "pathe": "^2.0.3",
        "scule": "^1.3.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.13",
        "jiti": "^2.4.2",
        "storybook": "9",
        "type-fest": "^4.41.0",
        "typescript": "^5.8.3",
        "unbuild": "^3.5.0"
    }
}
